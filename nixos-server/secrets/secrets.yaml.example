# This is a TEMPLATE, not a real secrets file. It shows exactly which
# keys the configuration expects. Copy it to secrets.yaml, fill in real
# values, then encrypt it in place with:
#
#   sops --encrypt --in-place secrets/secrets.yaml
#
# (run that AFTER copying — sops needs .sops.yaml's rules to already be
# pointing at your real age public key). Never commit an unencrypted
# secrets.yaml. secrets.yaml.example (this file) is safe to commit
# precisely because every value below is a placeholder.

wireguard:
  private-key: "YOUR_WIREGUARD_SERVER_PRIVATE_KEY" # `wg genkey`

nextcloud:
  admin-password: "YOUR_NEXTCLOUD_ADMIN_PASSWORD"
  db-password: "YOUR_NEXTCLOUD_DB_PASSWORD"

forgejo:
  db-password: "YOUR_FORGEJO_DB_PASSWORD"

# Vaultwarden reads this as an EnvironmentFile (KEY=VALUE lines), not a
# single value — it must contain at least ADMIN_TOKEN.
vaultwarden:
  env: |
    ADMIN_TOKEN=YOUR_LONG_RANDOM_ADMIN_TOKEN

# Immich's Postgres container and immich-server both read this as an
# EnvironmentFile; both variable names are required and must match.
immich:
  db-password: |
    POSTGRES_PASSWORD=YOUR_IMMICH_DB_PASSWORD
    DB_PASSWORD=YOUR_IMMICH_DB_PASSWORD

alertmanager:
  smtp-password: "YOUR_SMTP_ACCOUNT_PASSWORD"

restic:
  password: "YOUR_RESTIC_REPOSITORY_ENCRYPTION_PASSWORD"
